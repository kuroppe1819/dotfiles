prefix_rule(
    pattern = ["sudo"],
    decision = "forbidden",
    justification = "Do not run privileged commands.",
)

prefix_rule(
    pattern = ["rm", ["-rf", "-fr"]],
    decision = "forbidden",
    justification = "Do not recursively force-delete files.",
)

prefix_rule(
    pattern = ["git", "push"],
    decision = "forbidden",
    justification = "Do not push without explicit user action.",
)

prefix_rule(
    pattern = ["git", "reset"],
    decision = "forbidden",
    justification = "Do not reset repository state.",
)

prefix_rule(
    pattern = ["git", "rebase"],
    decision = "forbidden",
    justification = "Do not rewrite history.",
)

prefix_rule(
    pattern = ["dd"],
    decision = "forbidden",
    justification = "Do not run raw disk copy commands.",
)

prefix_rule(
    pattern = ["mkfs"],
    decision = "forbidden",
    justification = "Do not format filesystems.",
)

prefix_rule(
    pattern = ["chmod", "777"],
    decision = "forbidden",
    justification = "Do not make files world-writable.",
)

prefix_rule(
    pattern = ["curl"],
    decision = "forbidden",
    justification = "Do not fetch arbitrary network content.",
)

prefix_rule(
    pattern = ["npm", "install"],
    decision = "forbidden",
    justification = "Do not install dependencies without review.",
)
