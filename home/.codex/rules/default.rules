prefix_rule(
    pattern = ["git", "push"],
    decision = "forbidden",
    justification = "Pushing is reserved for the user.",
)

prefix_rule(
    pattern = ["gh", "pr", "merge"],
    decision = "forbidden",
    justification = "PR merging is reserved for the user.",
)

prefix_rule(
    pattern = ["gh", "issue", "delete"],
    decision = "forbidden",
    justification = "Issue deletion is not allowed.",
)
